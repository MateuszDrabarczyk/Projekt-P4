<Window x:Class="PrzychodniaApp.Views.PatientSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Wybierz Pacjenta" Height="450" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtSearch" Grid.Row="0"
                 materialDesign:HintAssist.Hint="Filtruj po Nazwisku, Imieniu lub PESEL"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 TextChanged="txtSearch_TextChanged" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgPatientsSearch" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  MouseDoubleClick="dgPatientsSearch_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" Width="*"/>
                <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="*"/>
                <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Anuluj" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <Button x:Name="btnSelect" Content="Wybierz" Click="btnSelect_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>