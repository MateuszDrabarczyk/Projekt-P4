<Window x:Class="PrzychodniaApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Logowanie - System Przychodnia" Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" Background="{DynamicResource MaterialDesignPaper}">
    <Grid VerticalAlignment="Center" Margin="30">
        <StackPanel>
            <materialDesign:PackIcon Kind="HospitalBuilding" Width="80" Height="80" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Logowanie" Style="{StaticResource MaterialDesignHeadline4TextBlock}" HorizontalAlignment="Center" Margin="0,10,0,30"/>

            <TextBox x:Name="txtLogin" materialDesign:HintAssist.Hint="Login" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,10" Text="s" TextChanged="txtLogin_TextChanged"/>
            <PasswordBox x:Name="txtHaslo" materialDesign:HintAssist.Hint="Hasło" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,10"/>

            <Button Content="ZALOGUJ" Click="btnLogin_Click" Margin="0,30,0,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>