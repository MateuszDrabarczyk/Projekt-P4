<Window x:Class="PrzychodniaApp.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:PrzychodniaApp.Views"
        mc:Ignorable="d"
        Title="Dane Pacjenta" Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="15">
        <materialDesign:Card UniformCornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="Karta Pacjenta" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Center" 
                           FontWeight="Bold"/>

                <TextBox x:Name="txtPesel" 
                         materialDesign:HintAssist.Hint="PESEL (11 cyfr)" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         MaxLength="11"
                         PreviewTextInput="OnlyNumbers_PreviewTextInput"
                         Margin="0,0,0,15"/>

                <TextBox x:Name="txtImie" 
                         materialDesign:HintAssist.Hint="Imię" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         MaxLength="50"
                         Margin="0,0,0,15"/>

                <TextBox x:Name="txtNazwisko" 
                         materialDesign:HintAssist.Hint="Nazwisko" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         MaxLength="50"
                         Margin="0,0,0,15"/>

                <TextBox x:Name="txtTelefon" 
                         materialDesign:HintAssist.Hint="Telefon (9 cyfr)" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         MaxLength="9"
                         PreviewTextInput="OnlyNumbers_PreviewTextInput"
                         Margin="0,0,0,15"/>

                <TextBox x:Name="txtAdres" 
                         materialDesign:HintAssist.Hint="Adres zamieszkania" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         MaxLength="255"
                         Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" 
                            IsCancel="True" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Margin="0,0,10,0"/>

                    <Button x:Name="btnSave" 
                            Content="Zapisz" 
                            Click="btnSave_Click" 
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>